# Settings for docker-compose.yml on a server. Copy this file to .env beside docker-compose.yml
# (git ignores .env) and fill it in. Nothing here is read on a Mac.

# A Tailscale auth key for the sidecar to join your tailnet with, from the admin console
# (Settings > Keys > Generate auth key). The node keeps its identity in FINANCE_TAILSCALE_STATE,
# so the key is used once; a reusable key lets a fresh state folder join again.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Tailscale login the page answers, as the admin console shows it: your own account. Any
# other login on the tailnet gets a refusal instead of the page.
FINANCE_TAILSCALE_LOGIN=pat@example.com

# Where the data folder lives on the host: finance.db, every export, rules.csv, budget.toml and
# accounts.toml. It must belong to user id 1000, which the page runs as.
FINANCE_DATA=/mnt/fast/apps/finance/data

# Where the Tailscale node keeps its identity on the host.
FINANCE_TAILSCALE_STATE=/mnt/fast/apps/finance/tailscale
